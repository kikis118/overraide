---
// A plain white one-page document, unlisted and not indexed. Used for /proposal/.
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{frontmatter.title}</title>
  <style is:global>
    :root { color-scheme: light; }
    body { margin: 0; background: #e6e6e6; color: #111; font: 16px/1.55 "Segoe UI", system-ui, -apple-system, sans-serif; }
    .sheet { max-width: 794px; margin: 0 auto; background: #fff; padding: 72px 76px 80px; min-height: 100vh; }
    .sheet h1 { font-weight: 400; font-size: 3.1rem; line-height: 1.1; margin: 0 0 .2em; letter-spacing: .01em; }
    .sheet p { margin: 0 0 1.15em; }
    .sheet img { display: block; width: 100%; height: auto; margin: 1.1em 0 .6em; }
    .sheet figure.frames { position: relative; margin: 1.1em 0 .6em; }
    .sheet figure.frames img { margin: 0; }
    .sheet figure.frames p { margin: 0; }
    .sheet .wip { position: absolute; left: 10px; top: 10px; font: 600 11px/1 system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,.62); padding: 6px 9px; border-radius: 3px; }
    .sheet h1 + p { font-size: .95rem; margin-bottom: 0; }
    .sheet a { color: inherit; }
    .sheet .ai { color: #e01e1e; }
    @media (max-width: 640px) { .sheet { padding: 40px 22px 56px; } .sheet h1 { font-size: 2.4rem; } }
    @media print { body { background: #fff; } .sheet { padding: 0; max-width: none; min-height: 0; } @page { margin: 18mm; } }
  </style>
</head>
<body><main class="sheet"><slot /></main></body>
</html>
