---
import "../styles/global.css";
import { LAUNCHED } from "../site.config";
interface Props { title?: string; description?: string }
const { title, description = "Developmental weblog for an experimental film about invisible editing." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteName = "overraide";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · ${siteName}` : siteName}</title>
  <meta name="description" content={description} />
  {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="name" href={`${base}/`}>OVERRAIDE</a>
      {LAUNCHED && (
        <nav>
          <a href={`${base}/`}>Posts</a>
          <a href={`${base}/film/`}>The film</a>
          <a href={`${base}/marking/`}>Marking guide</a>
          <a href={`${base}/references/`}>References</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
      )}
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site"><div class="wrap">CIN506 Experimental Film and Animation · Ulster University</div></footer>
</body>
</html>
